# Copy to .env (npm start creates one for you on first run).
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
# Your https address in production, e.g. https://apps.example.com (turns on Secure cookies and fixes invite links)
PUBLIC_URL=
# Used once, only when the database has no users yet. Leave empty to have one generated and printed.
ADMIN_EMAIL=admin@jhino.local
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# Videos this size and up are made smaller in the background (0 turns it off).
COMPRESS_VIDEO_MB=20

# ---- Email (verification, password reset, receipts, reminders) ----
# Without SMTP_URL, emails are not sent; Super Admin → Settings shows them so you can pass links on by hand.
# Example: smtps://user%40example.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Jhino <no-reply@example.com>
# Support requests are also emailed here (can be changed in Super Admin → Settings).
SUPPORT_EMAIL=

# ---- Continue with Google / Apple (buttons appear only when these are set) ----
# Google: create an OAuth client (Web). Redirect URI: <PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: a Services ID, your Team ID, a Sign in with Apple key ID and its .p8 key (newlines as \n).
# Return URL: <PUBLIC_URL>/api/auth/oauth/apple/callback (Apple needs https)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
