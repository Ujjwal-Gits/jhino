# Copy to .env (npm start creates one for you on first run).
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
# Your https address in production, e.g. https://apps.example.com (turns on Secure cookies and fixes invite links)
PUBLIC_URL=
# Used once, only when the database has no users yet. Leave empty to have one generated and printed.
ADMIN_EMAIL=admin@jhino.local
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# Videos this size and up are made smaller in the background (0 turns it off).
COMPRESS_VIDEO_MB=20

# ---- Email (6-digit codes for sign-up, password reset and email change; receipts; reminders) ----
# Resend's HTTP API is used when RESEND_API_KEY is set (recommended); otherwise SMTP_URL.
# Without either, emails are not sent; Super Admin → Settings shows them so you can pass codes on by hand.
# Until your domain is verified in Resend, MAIL_FROM=Jhino <onboarding@resend.dev> only delivers to the Resend account's own email.
RESEND_API_KEY=
# Resend (recommended for app email):  smtps://resend:re_YOUR_API_KEY@smtp.resend.com:465
# Zoho Mail (a mailbox you also read): smtps://support%40your-domain.com:APP_PASSWORD@smtppro.zoho.com:465
# Write @ : / # in a password URL-encoded (%40 %3A %2F %23). MAIL_FROM must be on a domain the provider verified.
SMTP_URL=
MAIL_FROM=Jhino <no-reply@example.com>
# Support requests are also emailed here (can be changed in Super Admin → Settings).
SUPPORT_EMAIL=

# ---- Continue with Google / Apple (buttons appear only when these are set) ----
# Google: create an OAuth client (Web). Redirect URI: <PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: a Services ID, your Team ID, a Sign in with Apple key ID and its .p8 key (newlines as \n).
# Return URL: <PUBLIC_URL>/api/auth/oauth/apple/callback (Apple needs https)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Operations ----
# A database copy every day in BACKUP_DIR/auto (last 14 kept). 0 turns it off.
AUTO_BACKUP=1
# Extra proxies in front of Jhino (comma-separated CIDRs), on top of local networks and Cloudflare.
TRUSTED_PROXIES=
