{
  "name": "jhino",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "playwright test",
    "backup": "node dist/server/backup.js",
    "admin": "node dist/server/admin.js"
  },
  "license": "UNLICENSED",
  "description": "Jhino: small apps, real work. Self-hosted home for AI-made HTML apps.",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
